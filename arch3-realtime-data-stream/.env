AWS_REGION=ap-northeast-2
PROJECT=kinesis-analytics-demo

BUCKET=kinesis-analytics-demo-000000000000

KINESIS_STREAM=kinesis-analytics-demo-stream
KINESIS_ARN=arn:aws:kinesis:ap-northeast-2:000000000000:stream/kinesis-analytics-demo-stream

FIREHOSE_S3=kinesis-analytics-demo-to-s3
FIREHOSE_OS=kinesis-analytics-demo-to-os

GLUE_DATABASE=kinesis-analytics-demo_db
GLUE_TABLE=kinesis-analytics-demo_events

ATHENA_WORKGROUP=kinesis-analytics-demo-workgroup

OPENSEARCH_DOMAIN=kinesis-analytics-demo-os
OPENSEARCH_ARN=arn:aws:es:ap-northeast-2:000000000000:domain/kinesis-analytics-demo-os
OPENSEARCH_ENDPOINT=http://floci-opensearch-kinesis-analytics-demo-os:9200
OPENSEARCH_INDEX=events
